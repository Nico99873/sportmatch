# Postgres connection string from Neon (Vercel Storage tab, or neon.tech directly)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign session tokens. Generate a real one for production with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# Base URL of the deployed app. Usually not needed on Vercel (auto-detected),
# only required for local development.
NEXTAUTH_URL="http://localhost:3000"

# Resend API key, used to email ASDs when they receive a contact request.
# Get one at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Admin email — receives upgrade requests from ASDs. Never exposed to users.
ADMIN_EMAIL="your-email@example.com"

# Secret used to authenticate Vercel Cron requests. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="generate-a-random-secret"
