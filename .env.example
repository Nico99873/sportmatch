# Postgres connection string from Neon (Vercel Storage tab, or neon.tech directly)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign session tokens. Generate a real one for production with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# Base URL of the deployed app. Usually not needed on Vercel (auto-detected),
# only required for local development.
NEXTAUTH_URL="http://localhost:3000"
